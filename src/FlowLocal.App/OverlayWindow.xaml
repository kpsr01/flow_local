<Window x:Class="FlowLocal.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="FlowLocal dictation status" SizeToContent="WidthAndHeight" WindowStyle="None"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent" Focusable="False" IsTabStop="False"
        automation:AutomationProperties.Name="FlowLocal dictation status"
        WindowStartupLocation="Manual" SizeChanged="OverlayWindow_SizeChanged">
    <Window.Resources>
        <Storyboard x:Key="IntroStoryboard">
            <DoubleAnimation Storyboard.TargetName="Root"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.16" />
            <DoubleAnimation Storyboard.TargetName="RootTranslate"
                             Storyboard.TargetProperty="Y"
                             From="8" To="0" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="ThinkingStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             Storyboard.TargetName="DotA"
                             From="0.2" To="1" Duration="0:0:0.55" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             Storyboard.TargetName="DotB"
                             From="0.2" To="1" BeginTime="0:0:0.15" Duration="0:0:0.55" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             Storyboard.TargetName="DotC"
                             From="0.2" To="1" BeginTime="0:0:0.3" Duration="0:0:0.55" AutoReverse="True" />
        </Storyboard>

        <Style x:Key="RoundIconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Foreground" Value="#FFA8A49C" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Chrome" Fill="#14FFFFFF" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Fill" Value="#2EFFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Fill" Value="#0FFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AcceptIconButton" TargetType="Button" BasedOn="{StaticResource RoundIconButton}">
            <Setter Property="Foreground" Value="#FF231108" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Chrome" Fill="#FF7C48" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Fill" Value="#FF855F" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Fill" Value="#E0522A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid x:Name="PillHost" MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave">
        <Border x:Name="Root" Background="#F2151518"
                BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="8"
                Padding="10,6" RenderTransformOrigin="0.5,1" MouseLeftButtonDown="Root_ClickStart">
            <Border.RenderTransform>
                <TransformGroup>
                    <TranslateTransform x:Name="RootTranslate" />
                    <ScaleTransform x:Name="RootScale" />
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="8" Direction="270"
                                  Opacity="0.5" Color="#000000" />
            </Border.Effect>
            <Grid>
            <!-- Idle: ember dot at rest; mic glyph appears on hover -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="MiniDot" Text="&#xE720;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="14" Foreground="#FFFF6B3D" VerticalAlignment="Center" Visibility="Collapsed"
                           automation:AutomationProperties.Name="FlowLocal ready - click to dictate" />
            </StackPanel>

            <!-- Active states -->
            <Grid x:Name="ActiveRow" Height="30" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel x:Name="WavePanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <Rectangle x:Name="Bar0" Width="3.5" RadiusX="1.75" RadiusY="1.75" VerticalAlignment="Center" Fill="#FFFF6B3D" Margin="0,0,3,0" />
                        <Rectangle x:Name="Bar1" Width="3.5" RadiusX="1.75" RadiusY="1.75" VerticalAlignment="Center" Fill="#FFFF6B3D" Margin="0,0,3,0" />
                        <Rectangle x:Name="Bar2" Width="3.5" RadiusX="1.75" RadiusY="1.75" VerticalAlignment="Center" Fill="#FFFF855F" Margin="0,0,3,0" />
                        <Rectangle x:Name="Bar3" Width="3.5" RadiusX="1.75" RadiusY="1.75" VerticalAlignment="Center" Fill="#FFFF6B3D" Margin="0,0,3,0" />
                        <Rectangle x:Name="Bar4" Width="3.5" RadiusX="1.75" RadiusY="1.75" VerticalAlignment="Center" Fill="#FFFF6B3D" Margin="0,0,9,0" />
                        <TextBlock x:Name="DurationText" FontFamily="{StaticResource FontMono}" FontSize="11"
                                   Foreground="#FFA8A49C" VerticalAlignment="Center" Text="0:00"
                                   automation:AutomationProperties.LiveSetting="Off"
                                   automation:AutomationProperties.Name="Recording duration" />
                    </StackPanel>
                    <StackPanel x:Name="ThinkingDots" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <Ellipse x:Name="DotA" Width="5" Height="5" Margin="2,0" Fill="#FFA8A49C" />
                        <Ellipse x:Name="DotB" Width="5" Height="5" Margin="2,0" Fill="#FFA8A49C" />
                        <Ellipse x:Name="DotC" Width="5" Height="5" Margin="2,0" Fill="#FFA8A49C" />
                    </StackPanel>
                    <TextBlock x:Name="IssueIcon" Text="&#xE783;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="11" Foreground="#FFFFB35C" VerticalAlignment="Center" Margin="4,0,8,0"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="StatusText" MaxWidth="230" FontSize="12"
                               FontFamily="{StaticResource FontDisplay}" FontWeight="SemiBold"
                               Foreground="#FFF2F0EC" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Visibility="Collapsed"
                               automation:AutomationProperties.LiveSetting="Assertive"
                               automation:AutomationProperties.Name="FlowLocal dictation status: Ready" />
                </StackPanel>

                <Button x:Name="CancelButton" Grid.Column="0" Style="{StaticResource RoundIconButton}"
                        Content="&#xE711;" Click="Cancel_Click" Margin="2,0,7,0" Visibility="Collapsed"
                        automation:AutomationProperties.Name="Cancel dictation"
                        automation:AutomationProperties.HelpText="Discards the current recording." />

                <Grid Grid.Column="2">
                    <Button x:Name="AcceptButton" Style="{StaticResource AcceptIconButton}"
                            Content="&#xE73E;" Click="Stop_Click" Margin="7,0,2,0" Visibility="Collapsed"
                            automation:AutomationProperties.Name="Finish dictation"
                            automation:AutomationProperties.HelpText="Stops recording, then transcribes, cleans, and inserts the transcript." />
                    <StackPanel x:Name="ActionPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <Button x:Name="RetryButton" Style="{StaticResource RoundIconButton}" Content="&#xE72C;"
                                Click="Retry_Click" Margin="7,0,0,0"
                                automation:AutomationProperties.Name="Retry failed dictation"
                                automation:AutomationProperties.HelpText="Runs recognition again from the saved recording." />
                        <Button Style="{StaticResource RoundIconButton}" Content="&#xE713;" Click="OpenApp_Click"
                                Margin="4,0,2,0" automation:AutomationProperties.Name="Open FlowLocal settings"
                                automation:AutomationProperties.HelpText="Opens the main FlowLocal window." />
                    </StackPanel>
                </Grid>
            </Grid>
            </Grid>
        </Border>
        <Button x:Name="ExitPillButton" Content="&#xE8BB;" Style="{StaticResource RoundIconButton}"
                Width="16" Height="16" FontSize="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                Visibility="Collapsed" Click="Exit_Click" ToolTip="Exit FlowLocal"
                automation:AutomationProperties.Name="Exit FlowLocal"
                automation:AutomationProperties.HelpText="Closes FlowLocal completely.">
            <Button.RenderTransform>
                <TranslateTransform X="7" Y="-7" />
            </Button.RenderTransform>
        </Button>
        </Grid>
    </Grid>
</Window>
