<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- transcribe.cpp native release (transcribe.dll + ggml CPU backends) -->
    <TranscribeNativeVersion>0.2.1</TranscribeNativeVersion>
    <TranscribeNativeUrl>https://github.com/handy-computer/transcribe.cpp/releases/download/v$(TranscribeNativeVersion)/transcribe-native-$(TranscribeNativeVersion)-windows-x86_64-cpu-vulkan.tar.gz</TranscribeNativeUrl>
    <TranscribeNativeDir>$(MSBuildThisFileDirectory)obj\transcribe-native\$(TranscribeNativeVersion)</TranscribeNativeDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(TranscribeNativeDir)\*.dll" Condition="Exists('$(TranscribeNativeDir)\transcribe.dll')"
          CopyToOutputDirectory="PreserveNewest" Link="%(FileName)%(Extension)" Visible="false" />
  </ItemGroup>
  <Target Name="FetchTranscribeNative" BeforeTargets="AssignTargetPaths"
          Condition="!Exists('$(TranscribeNativeDir)\transcribe.dll')">
    <MakeDir Directories="$(TranscribeNativeDir)" />
    <Exec Command="curl.exe -sSfL -o &quot;$(TranscribeNativeDir)\native.tar.gz&quot; $(TranscribeNativeUrl)" ConsoleToMsBuild="true" />
    <Exec Command="tar -xzf &quot;$(TranscribeNativeDir)\native.tar.gz&quot; -C &quot;$(TranscribeNativeDir)&quot; --strip-components=1" />
  </Target>
</Project>
