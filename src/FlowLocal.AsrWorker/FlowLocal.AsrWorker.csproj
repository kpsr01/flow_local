<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <Target Name="BuildNativeAsr" BeforeTargets="AssignTargetPaths">
    <Exec Command="cargo build --release --manifest-path &quot;$(MSBuildThisFileDirectory)native\Cargo.toml&quot;" />
  </Target>
  <ItemGroup>
    <None Include="native\target\release\flowlocal-asr-native.exe" CopyToOutputDirectory="PreserveNewest" Link="flowlocal-asr-native.exe" />
    <None Include="native\target\release\onnxruntime.dll" CopyToOutputDirectory="PreserveNewest" Link="onnxruntime.dll" Condition="Exists('native\target\release\onnxruntime.dll')" />
  </ItemGroup>
</Project>
